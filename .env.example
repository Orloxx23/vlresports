# Optional: route all vlr.gg requests through a Cloudflare Worker (or any
# compatible proxy) so vlr.gg never sees your server's real IP. Highly
# recommended in production to avoid IP-level rate limiting / bans.
#
# When both vars are set, every request to vlr.gg goes through:
#   ${VLR_PROXY_URL}?u=<encoded vlr.gg URL>
# with the header `X-Proxy-Token: ${VLR_PROXY_TOKEN}`.
#
# When either is empty, the API talks to vlr.gg directly.
VLR_PROXY_URL=
VLR_PROXY_TOKEN=

# Server port (defaults to 5000)
PORT=5000

# --- Abuse protection (CWE-770 mitigation) ---
# Per-IP rate limit for the scraper-backed API (/api/v1/*).
# Defaults: 30 requests per 60s window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Max jobs allowed in the shared scraper queue before new requests get 503.
# Caps worst-case added latency (VLR_MAX_QUEUE_LENGTH * 600ms). Default 50.
VLR_MAX_QUEUE_LENGTH=50

# Jobs that wait in the queue longer than this (ms) are dropped instead of
# fetched, and the request falls back to cached data if there is any.
# Default 30000.
VLR_QUEUE_MAX_WAIT_MS=30000

# Memory budget (MB) for the in-memory cache of vlr.gg pages. Default 32.
VLR_CACHE_MAX_MB=32

# Set when running behind a reverse proxy (Coolify/Traefik, nginx, a load
# balancer...), usually to "1". Without it every client is seen with the
# proxy's IP and they all share a single rate-limit bucket. Leave empty only
# when the app is exposed directly.
TRUST_PROXY=

# GlitchTip error tracking DSN. When empty, error tracking is disabled.
GLITCHTIP_DSN=
